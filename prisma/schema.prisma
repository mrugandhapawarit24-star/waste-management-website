// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String
  role      Role
  company   String?
  businessType String?
  address   String
  city      String
  state     String
  zipCode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings  WasteListing[]
}

enum Role {
  SELLER
  BUYER
}

model WasteListing {
  id            String   @id @default(cuid())
  type          String
  weight        Float
  unit          String
  price         Float
  location      String
  address       String
  contactNumber String
  description   String
  status        ListingStatus @default(ACTIVE)
  createdAt     DateTime @default(now())

  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  @@index([sellerId])
  @@index([status, createdAt])
}

enum ListingStatus {
  ACTIVE
  SOLD
  PENDING
}
